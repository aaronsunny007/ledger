# Copy to .env and fill in. .env is git-ignored; never commit keys.

# SEC asks every client to identify itself: "Your Name your@email.com"
SEC_USER_AGENT="Your Name your.email@example.com"

# Generator: gemini (free key at https://aistudio.google.com/apikey),
# groq (free key at https://console.groq.com/keys) or ollama (local, no key).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Leave empty for the provider's cheap default; LLM_MODEL_LARGE is used for retries.
LLM_MODEL=
LLM_MODEL_LARGE=
OLLAMA_URL=http://localhost:11434

# Store: memory (index saved under data/processed/index) or postgres.
STORE=memory
# docker compose default; or a Neon / Supabase free-tier connection string.
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger

# Tracing (optional): free cloud tier at https://cloud.langfuse.com
# Without keys every request is still logged to data/traces/requests.jsonl (no network).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Public demo guards
DAILY_SPEND_CAP_USD=1.0
RATE_LIMIT_PER_MINUTE=10
# Free-tier protection: answers that call the model per day (resets 07:00 UTC),
# overall and per client IP. Cache hits and advice refusals do not count.
LEDGER_DAILY_BUDGET=300
LEDGER_PER_CLIENT_DAILY=15
TRUSTED_PROXY_HOPS=1          # proxies that append to X-Forwarded-For; 0 = trust the connection only
# Optional JSON file so the counters survive a restart within the day.
LEDGER_BUDGET_FILE=
