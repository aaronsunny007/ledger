# Copy to .env and fill in. .env is git-ignored; never commit keys.

# SEC asks every client to identify itself: "Your Name your@email.com"
SEC_USER_AGENT="Your Name your.email@example.com"

# Generator: gemini (free key at https://aistudio.google.com/apikey),
# groq (free key at https://console.groq.com/keys) or ollama (local, no key).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Leave empty for the provider's cheap default; LLM_MODEL_LARGE is used for retries.
LLM_MODEL=
LLM_MODEL_LARGE=
OLLAMA_URL=http://localhost:11434

# Store: memory (index saved under data/processed/index) or postgres.
STORE=memory
# docker compose default; or a Neon / Supabase free-tier connection string.
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger

# Tracing (optional): free cloud tier at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Public demo guards
DAILY_SPEND_CAP_USD=1.0
RATE_LIMIT_PER_MINUTE=10
